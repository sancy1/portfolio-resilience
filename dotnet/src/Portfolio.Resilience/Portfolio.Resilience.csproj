<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Portfolio.Resilience</RootNamespace>
    <AssemblyName>Portfolio.Resilience</AssemblyName>

    <!-- ============================================================ -->
    <!-- Package metadata — visible on nuget.org                     -->
    <!-- ============================================================ -->
    <Version>0.5.0</Version>
    <PackageId>Portfolio.Resilience</PackageId>
    <Authors>Alexander Sanchez Cyril</Authors>
    <Company>Alexander Sanchez Cyril</Company>
    <Description>Resilience primitives for .NET: retry, circuit breaker, timeout, fallback, correlation, structured logging, and latency metrics. Small, spec-driven, and dependency-free.</Description>
    <PackageTags>resilience;circuit-breaker;retry;timeout;fallback;correlation;logging;metrics;polly-alternative;dotnet;microservices</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/sancy1/portfolio-resilience</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sancy1/portfolio-resilience</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- ============================================================ -->
    <!-- Debug symbols — shipped as .snupkg alongside the .nupkg     -->
    <!-- ============================================================ -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- ============================================================ -->
    <!-- Reproducible builds                                         -->
    <!-- ============================================================ -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- ============================================================ -->
    <!-- XML documentation generation (ships with the package)      -->
    <!-- ============================================================ -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!-- Pack README and LICENSE into the .nupkg root so they appear -->
  <!-- on the NuGet package page.                                  -->
  <!-- ============================================================ -->
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\LICENSE"   Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
