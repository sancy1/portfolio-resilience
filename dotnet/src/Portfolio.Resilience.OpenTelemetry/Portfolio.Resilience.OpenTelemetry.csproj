<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Portfolio.Resilience.OpenTelemetry</RootNamespace>
    <AssemblyName>Portfolio.Resilience.OpenTelemetry</AssemblyName>

    <!-- ============================================================ -->
    <!-- Package metadata - visible on nuget.org                      -->
    <!-- ============================================================ -->
    <Version>0.7.0</Version>
    <PackageId>Portfolio.Resilience.OpenTelemetry</PackageId>
    <Authors>Alexander Sanchez Cyril</Authors>
    <Company>Alexander Sanchez Cyril</Company>
    <Description>OpenTelemetry sinks for Portfolio.Resilience. Exports resilience events as OTel logs and metrics as OTel histograms. Optional package - the core library remains zero-dependency.</Description>
    <PackageTags>resilience;opentelemetry;otel;observability;tracing;metrics;logs;polly-alternative;dotnet;microservices</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/sancy1/portfolio-resilience</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sancy1/portfolio-resilience</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- ============================================================ -->
    <!-- Debug symbols - shipped as .snupkg alongside the .nupkg      -->
    <!-- ============================================================ -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- ============================================================ -->
    <!-- Reproducible builds                                          -->
    <!-- ============================================================ -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- ============================================================ -->
    <!-- XML documentation generation (ships with the package)       -->
    <!-- ============================================================ -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Resilience\Portfolio.Resilience.csproj" />
  </ItemGroup>

  <!-- ============================================================ -->
  <!-- Pack README and LICENSE into the .nupkg root so they appear  -->
  <!-- on the NuGet package page.                                   -->
  <!-- ============================================================ -->
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\LICENSE"   Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
